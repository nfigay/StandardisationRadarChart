{
  "name": "standardisation-radarchart",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-safe.mjs local",
    "build:pages": "node scripts/build-pages-complete.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "verify:build": "node scripts/verify-build.mjs local",
    "verify:pages": "node scripts/verify-build.mjs pages",
    "preview": "vite preview --outDir .radarchart-build/local --host 127.0.0.1",
    "preview:pages": "vite preview --outDir .radarchart-build/pages --host 127.0.0.1",
    "build:client": "node scripts/build-client.mjs",
    "verify:client": "node scripts/verify-client-build.mjs .radarchart-build/client",
    "assemble:products": "node scripts/assemble-products.mjs assemble .radarchart-build/products $(git rev-parse --short HEAD)",
    "verify:products": "node scripts/assemble-products.mjs verify .radarchart-build/products",
    "build:dist": "node scripts/build-web-distribution.mjs build",
    "verify:dist": "node scripts/build-web-distribution.mjs verify"
  },
  "devDependencies": {
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
